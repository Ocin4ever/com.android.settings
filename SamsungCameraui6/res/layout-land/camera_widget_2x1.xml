<?xml version="1.0" encoding="utf-8"?>
<FrameLayout android:id="@id/widget_image_layer" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <ImageView android:layout_gravity="center" android:id="@id/widget_image" android:background="@drawable/widget_image_border" android:layout_width="fill_parent" android:layout_height="@dimen/widget_preview_image_max_height" android:scaleType="centerCrop" android:adjustViewBounds="true" android:clipToOutline="true" />
    <ImageView android:layout_gravity="center" android:id="@id/widget_dim_image" android:background="@drawable/widget_dim_image" android:layout_width="fill_parent" android:layout_height="fill_parent" android:scaleType="centerCrop" android:clipToOutline="true" />
    <LinearLayout android:layout_gravity="start|center" android:orientation="horizontal" android:id="@id/text_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="@dimen/widget_text_land_end_margin">
        <ImageView android:layout_gravity="center" android:id="@id/camera_icon" android:background="@drawable/widget_ic_camera" android:layout_width="@dimen/widget_camera_icon_size" android:layout_height="@dimen/widget_camera_icon_size" android:layout_marginStart="@dimen/widget_icon_side_margin" />
        <LinearLayout android:layout_gravity="start|center" android:orientation="vertical" android:id="@id/mode_layout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="@dimen/widget_title_text_land_start_margin" android:layout_marginEnd="@dimen/widget_text_land_end_margin">
            <TextView android:textSize="@dimen/widget_title_text_size" android:textColor="@color/widget_text_color" android:ellipsize="end" android:layout_gravity="start|center" android:id="@id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_title" android:singleLine="true" style="@style/SecSemiBold" />
            <TextView android:textSize="@dimen/widget_mode_text_size" android:textColor="@color/widget_text_color" android:ellipsize="end" android:layout_gravity="start|center" android:id="@id/widget_mode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/SM_PHOTO" android:singleLine="true" style="@style/SecRegular" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
