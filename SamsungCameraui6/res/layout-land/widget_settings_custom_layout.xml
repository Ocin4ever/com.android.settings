<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:id="@id/layout" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout android:theme="@style/Theme.AppCompat.DayNight" android:orientation="horizontal" android:id="@id/listview" android:background="@color/theme_bg_color" android:focusable="false" android:layout_width="fill_parent" android:layout_height="fill_parent" app:layout_behavior="@string/appbar_scrolling_view_behavior">
        <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent">
            <RelativeLayout android:layout_gravity="center_vertical" android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="@dimen/widget_setting_title_height_land" android:layout_marginHorizontal="@dimen/winset_list_item_end_padding">
                <TextView android:textSize="@dimen/widget_setting_title_text_size_land" android:textColor="@color/widget_text_color_normal" android:ellipsize="end" android:gravity="start|center" android:layout_width="wrap_content" android:layout_height="fill_parent" android:text="@string/widget_setting_title" android:maxLines="1" android:layout_alignParentStart="true" style="@style/SecSemiBold" />
                <LinearLayout android:gravity="end|center" android:orientation="horizontal" android:background="@color/widget_button_bg_color" android:layout_width="wrap_content" android:layout_height="fill_parent" android:layout_alignParentEnd="true">
                    <Button android:textSize="@dimen/widget_setting_button_text_size" android:gravity="center" android:id="@id/btn_cancel" android:background="@drawable/widget_button" android:layout_width="wrap_content" android:layout_height="fill_parent" android:text="@string/cancel" android:textAllCaps="false" android:textAlignment="center" android:layout_marginEnd="@dimen/widget_setting_button_end_margin" android:layout_marginVertical="@dimen/widget_setting_button_vertical_margin" android:paddingHorizontal="@dimen/widget_setting_button_horizontal_padding" style="@style/SecSemiBold" />
                    <Button android:textSize="@dimen/widget_setting_button_text_size" android:gravity="center" android:id="@id/btn_save" android:background="@drawable/widget_button" android:layout_width="wrap_content" android:layout_height="fill_parent" android:text="@string/save" android:textAllCaps="false" android:textAlignment="center" android:layout_marginVertical="@dimen/widget_setting_button_vertical_margin" android:paddingHorizontal="@dimen/widget_setting_button_horizontal_padding" style="@style/SecSemiBold" />
                </LinearLayout>
            </RelativeLayout>
            <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="fill_parent" android:layout_marginBottom="@dimen/widget_bottom_margin_land">
                <FrameLayout android:orientation="vertical" android:id="@id/setting_image_layer" android:layout_width="0.0dip" android:layout_height="wrap_content" android:layout_weight="0.55">
                    <ImageView android:id="@id/image_background" android:background="@drawable/widget_background_border" android:layout_width="fill_parent" android:layout_height="fill_parent" android:scaleType="centerCrop" android:clipToOutline="true" />
