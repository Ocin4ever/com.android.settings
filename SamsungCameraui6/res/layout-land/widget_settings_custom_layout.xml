                </FrameLayout>
                <androidx.core.widget.NestedScrollView android:id="@id/nestedScrollView" android:layout_width="0.0dip" android:layout_height="fill_parent" android:layout_weight="0.45" android:overScrollMode="always" android:layout_marginStart="@dimen/winset_list_item_start_padding">
                    <LinearLayout android:orientation="vertical" android:id="@id/fragment_container_layout" android:background="@color/theme_list_color" android:layout_width="fill_parent" android:layout_height="wrap_content" app:layout_behavior="@string/appbar_scrolling_view_behavior" />
                </androidx.core.widget.NestedScrollView>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>
